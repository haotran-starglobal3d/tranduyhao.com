---
import { COMPANY_URL, SITE_TITLE } from '../consts';

const path = Astro.url.pathname;
const items = [
	{ href: '/', label: 'Trang chủ' },
	{ href: '/about/', label: 'Giới thiệu' },
	{ href: '/cong-nghe/', label: 'Công nghệ' },
	{ href: '/du-an/', label: 'Dự án' },
	{ href: '/thanh-tuu/', label: 'Thành tựu' },
	{ href: '/bao-chi/', label: 'Báo chí' },
	{ href: '/doi-song/', label: 'Đời sống' },
	{ href: '/blog/', label: 'Bài viết' },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href.replace(/\/$/, '')));
---

<header>
	<nav class="container">
		<a class="brand" href="/">
			<span class="mark" aria-hidden="true"></span>
			{SITE_TITLE}
		</a>
		<div class="links">
			{items.map((i) => <a href={i.href} class:list={{ active: isActive(i.href) }}>{i.label}</a>)}
		</div>
		<a class="company" href={COMPANY_URL} target="_blank" rel="noopener">StarGlobal3D.com</a>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 20;
		background: rgba(7, 18, 38, 0.94);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		transition: box-shadow 0.3s ease;
	}
	:global(body.scrolled) header {
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 64px;
	}
	a {
		text-decoration: none;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-weight: 800;
		color: #fff;
		white-space: nowrap;
	}
	.mark {
		width: 12px;
		height: 12px;
		border-radius: 3px;
		background: var(--cyan);
		transform: rotate(45deg);
		animation: pulse 3s ease-in-out infinite;
	}
	@keyframes pulse {
		50% {
			box-shadow: 0 0 0 6px rgba(34, 211, 238, 0.18);
		}
	}
	.links {
		display: flex;
		gap: 0.25rem;
		flex-wrap: wrap;
	}
	.links a {
		padding: 0.4rem 0.8rem;
		border-radius: 999px;
		font-size: 0.95rem;
		color: #b8c7e0;
	}
	.links a:hover,
	.links a.active {
		color: #fff;
		background: rgba(255, 255, 255, 0.1);
	}
	@media (prefers-reduced-motion: reduce) {
		.mark {
			animation: none;
		}
	}
	.company {
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--cyan);
		white-space: nowrap;
	}
	@media (max-width: 860px) {
		nav {
			flex-wrap: wrap;
			padding: 0.6rem 0;
		}
		.company {
			display: none;
		}
		.links {
			flex-wrap: nowrap;
			width: 100%;
			overflow-x: auto;
			scrollbar-width: none;
			margin: 0 -0.4rem;
		}
		.links::-webkit-scrollbar {
			display: none;
		}
		.links a {
			padding: 0.3rem 0.65rem;
			font-size: 0.9rem;
			white-space: nowrap;
		}
	}
</style>
