---
import { COMPANY_URL, SITE_TAGLINE, SITE_TITLE } from '../consts';
import { links } from '../data/profile';

const today = new Date();
---

<footer>
	<div class="container inner">
		<div>
			<strong>{SITE_TITLE}</strong>
			<div class="tag">{SITE_TAGLINE}</div>
		</div>
		<div class="links">
			<a href="/about/">Giới thiệu</a>
			<a href="/cong-nghe/">Công nghệ</a>
			<a href="/du-an/">Dự án</a>
			<a href="/thanh-tuu/">Thành tựu</a>
			<a href="/bao-chi/">Báo chí</a>
			<a href="/doi-song/">Đời sống</a>
			<a href="/blog/">Bài viết</a>
			<a href={COMPANY_URL} target="_blank" rel="noopener">StarGlobal3D.com</a>
			<a href={links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
			<a href={links.facebook} target="_blank" rel="noopener">Facebook</a>
			<a href="/rss.xml">RSS</a>
		</div>
	</div>
	<div class="container copy">&copy; {today.getFullYear()} {SITE_TITLE}. All rights reserved.</div>
</footer>
<style>
	footer {
		padding: 2.5rem 0 2rem;
		background: #050d1c;
		color: #8196b8;
		font-size: 0.92rem;
	}
	.inner {
		display: flex;
		justify-content: space-between;
		gap: 1.5rem;
		flex-wrap: wrap;
	}
	strong {
		color: #fff;
	}
	.links {
		display: flex;
		gap: 1.1rem;
		flex-wrap: wrap;
	}
	.links a {
		color: #b8c7e0;
		text-decoration: none;
	}
	.links a:hover {
		color: #fff;
	}
	.copy {
		margin-top: 1.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		font-size: 0.85rem;
	}
</style>
