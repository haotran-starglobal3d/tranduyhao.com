---
// Nền "đám mây điểm" động cho phần đầu trang chủ: một mặt địa hình gợn sóng
// gồm các điểm có tọa độ x, y, z, xoay chậm, có tia quét chạy qua như máy quét laser 3D.
---

<canvas class="cloud" aria-hidden="true"></canvas>
<style>
	.cloud {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		opacity: 0.9;
		pointer-events: none;
	}
</style>
<script>
	const canvas = document.querySelector<HTMLCanvasElement>('canvas.cloud');
	const ctx = canvas?.getContext('2d');
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	if (canvas && ctx) {
		const N = window.innerWidth < 860 ? 34 : 54; // số điểm mỗi cạnh
		let w = 0;
		let h = 0;
		let dpr = 1;
		let visible = true;
		let mx = 0;
		let my = 0;
		const resize = () => {
			dpr = Math.min(window.devicePixelRatio || 1, 2);
			w = canvas.clientWidth;
			h = canvas.clientHeight;
			canvas.width = w * dpr;
			canvas.height = h * dpr;
		};
		const height = (x: number, z: number, t: number) =>
			Math.sin(x * 2.2 + t) * 0.16 + Math.cos(z * 2.6 - t * 0.7) * 0.14 + Math.sin((x + z) * 4 + t * 0.5) * 0.05;

		const draw = (ms: number) => {
			const t = ms / 1000;
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			ctx.clearRect(0, 0, w, h);
			const rot = t * 0.07 + mx * 0.25;
			const cos = Math.cos(rot);
			const sin = Math.sin(rot);
			const tilt = 0.92 + my * 0.12;
			const scale = Math.max(w, h) * 0.75;
			const scan = ((t * 0.22) % 1.6) - 0.8; // vị trí tia quét theo trục x
			for (let i = 0; i < N; i++) {
				for (let j = 0; j < N; j++) {
					const x0 = (i / (N - 1) - 0.5) * 2;
					const z0 = (j / (N - 1) - 0.5) * 2;
					const y0 = height(x0, z0, t * 0.6);
					const x = x0 * cos - z0 * sin;
					const z = x0 * sin + z0 * cos;
					const y = y0 * Math.cos(tilt) - z * Math.sin(tilt);
					const depth = z * Math.cos(tilt) + y0 * Math.sin(tilt) + 2.4;
					const px = w * 0.5 + (x / depth) * scale;
					const py = h * 0.62 + (y / depth) * scale;
					if (px < -10 || px > w + 10 || py < -10 || py > h + 10) continue;
					const near = Math.max(0, 1 - Math.abs(x0 - scan) * 9);
					const fade = Math.max(0, Math.min(1, (3.4 - depth) / 1.6));
					const a = (0.12 + (y0 + 0.35) * 0.55) * fade + near * 0.7;
					const r = (1.5 / depth) * (1 + near * 1.4);
					ctx.fillStyle = near > 0.05 ? `rgba(245,185,66,${Math.min(a, 1)})` : `rgba(34,211,238,${Math.min(a, 0.85)})`;
					ctx.beginPath();
					ctx.arc(px, py, r, 0, 6.2832);
					ctx.fill();
				}
			}
		};
		const loop = (ms: number) => {
			if (visible) draw(ms);
			requestAnimationFrame(loop);
		};
		resize();
		window.addEventListener('resize', resize);
		if (reduce) {
			draw(4000);
		} else {
			new IntersectionObserver((e) => (visible = e[0].isIntersecting)).observe(canvas);
			window.addEventListener(
				'pointermove',
				(ev) => {
					mx = ev.clientX / window.innerWidth - 0.5;
					my = ev.clientY / window.innerHeight - 0.5;
				},
				{ passive: true },
			);
			requestAnimationFrame(loop);
		}
	}
</script>
