---
import { Image } from 'astro:assets';
import { lifeGroups, lifeImg } from '../data/life';
import { links } from '../data/profile';
import Site from '../layouts/Site.astro';

const total = lifeGroups.reduce((n, g) => n + g.photos.length, 0);
---

<Site
	title="Đời sống - Dr. Tran Duy Hao"
	description="Góc đời thường của TS. Trần Duy Hào: những chuyến đi, ngày hội cổ vũ, vườn rau giàn lan và vài dòng tự ghi."
	image={lifeImg('ha-giang-km0')}
>
	<section class="page-top">
		<div class="container">
			<span class="eyebrow" data-reveal>Đời sống</span>
			<h1 data-reveal style="--d:80ms">Ngoài công việc, một <span class="gradient-text">đời thường</span> rất đời</h1>
			<p class="lead" data-reveal style="--d:160ms">
				{total} khoảnh khắc chọn từ trang Facebook cá nhân: đi, cổ vũ, trồng rau, chăm lan và đôi
				lúc viết vài câu cho riêng mình.
			</p>
			<nav class="jump" data-reveal style="--d:240ms" aria-label="Các nhóm ảnh">
				{lifeGroups.map((g) => <a href={`#${g.id}`}>{g.eyebrow}</a>)}
			</nav>
		</div>
	</section>

	{
		lifeGroups.map((g, gi) => (
			<section class:list={['section', { alt: gi % 2 === 1 }]} id={g.id}>
				<div class="container">
					<span class="eyebrow" data-reveal>{g.eyebrow}</span>
					<h2 data-reveal>{g.title}</h2>
					<p class="lead" data-reveal>{g.lead}</p>
					<div class="wall" data-stagger="70">
						{g.photos.map((p, i) => (
							<figure class="shot">
								<div class="frame">
									<Image
										src={lifeImg(p.image)}
										alt={p.caption}
										widths={[480, 800, 1200]}
										sizes="(max-width: 640px) 100vw, (max-width: 980px) 50vw, 380px"
										loading={gi === 0 && i < 3 ? 'eager' : 'lazy'}
									/>
								</div>
								<figcaption>
									{p.quote ? <q>{p.caption}</q> : <span>{p.caption}</span>}
									<time>{p.when}</time>
								</figcaption>
							</figure>
						))}
					</div>
				</div>
			</section>
		))
	}

	<section class="section dark">
		<div class="container" data-reveal="zoom">
			<h2>Theo dõi thêm trên Facebook</h2>
			<p class="lead">Những ghi chép và hình ảnh mới nhất được cập nhật trên trang cá nhân.</p>
			<p><a class="btn" href={links.facebook} target="_blank" rel="noopener">Mở trang Facebook</a></p>
		</div>
	</section>
</Site>

<style>
	.jump {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 1.5rem;
	}
	.jump a {
		padding: 0.4rem 0.95rem;
		border: 1px solid rgba(255, 255, 255, 0.25);
		border-radius: 999px;
		color: #dbeafe;
		font-size: 0.9rem;
		font-weight: 600;
		text-decoration: none;
		transition:
			background 0.25s ease,
			border-color 0.25s ease;
	}
	.jump a:hover {
		background: rgba(34, 211, 238, 0.18);
		border-color: rgba(34, 211, 238, 0.6);
	}
	section[id] {
		scroll-margin-top: 72px;
	}
	.wall {
		columns: 3;
		column-gap: 1.25rem;
		margin-top: 2rem;
	}
	.shot {
		break-inside: avoid;
		margin: 0 0 1.25rem;
		overflow: hidden;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 16px;
		background: #fff;
		box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
		transition:
			transform 0.35s ease,
			box-shadow 0.35s ease;
	}
	.shot:hover {
		transform: translateY(-4px);
		box-shadow: 0 22px 50px rgba(15, 23, 42, 0.18);
	}
	.frame {
		overflow: hidden;
	}
	.frame :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0;
		transition: transform 0.9s ease;
	}
	.shot:hover .frame :global(img) {
		transform: scale(1.05);
	}
	figcaption {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.8rem 1rem 0.9rem;
		font-size: 0.95rem;
		line-height: 1.45;
		color: rgb(var(--gray-dark));
	}
	figcaption q {
		font-style: italic;
	}
	figcaption time {
		flex: none;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--accent);
		white-space: nowrap;
	}
	@media (max-width: 980px) {
		.wall {
			columns: 2;
		}
	}
	@media (max-width: 640px) {
		.wall {
			columns: 1;
		}
	}
</style>
