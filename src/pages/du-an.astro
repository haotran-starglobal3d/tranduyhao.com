---
import { Image } from 'astro:assets';
import { img } from '../data/images';
import { industries, links, showcase, stats } from '../data/profile';
import Site from '../layouts/Site.astro';
---

<Site
	title="Dự án tiêu biểu - Dr. Tran Duy Hao"
	description="12 dự án số hóa 3D/360 tiêu biểu: bản đồ du lịch TP.HCM, Dinh Độc Lập, Bảo tàng Phụ nữ Nam Bộ, Ajinomoto, Sonadezi, Đại học Quốc gia Hà Nội và nhiều dự án khác."
	image={img('du-an-ban-do-du-lich-tphcm.jpg')}
>
	<section class="page-top">
		<div class="container">
			<span class="eyebrow" data-reveal>Dự án</span>
			<h1 data-reveal style="--d:80ms">Những không gian đã được <span class="gradient-text">số hóa</span></h1>
			<p class="lead" data-reveal style="--d:160ms">
				12 dự án tiêu biểu trong hơn {stats[0].value} dự án đã hoàn thành. Mỗi dự án đều đang chạy
				thật trên web, bấm vào để tham quan trực tiếp.
			</p>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="list">
				{showcase.map((p, i) => (
					<a class="item" href={p.url} target="_blank" rel="noopener" data-reveal={i % 2 ? 'right' : 'left'}>
						<div class="shot">
							<Image src={img(p.image)} alt={p.title} widths={[640, 1280]} sizes="(max-width: 860px) 100vw, 620px" loading={i < 2 ? 'eager' : 'lazy'} />
							<span class="scanline" aria-hidden="true"></span>
						</div>
						<div class="info">
							<span class="idx">{String(i + 1).padStart(2, '0')}</span>
							<span class="chip">{p.tag}</span>
							<h2>{p.title}</h2>
							<p>{p.text}</p>
							<span class="go">Tham quan trực tuyến</span>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>

	<section class="section alt">
		<div class="container">
			<span class="eyebrow" data-reveal>Lĩnh vực</span>
			<h2 data-reveal>Nền tảng dùng được cho nhiều ngành</h2>
			<div class="grid cols-3" data-stagger="70">
				{industries.map((i) => (
					<div class="card lift">
						<h3>{i.title}</h3>
						<p>{i.text}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="section dark">
		<div class="container" data-reveal="zoom">
			<h2>Xem thêm dự án tại StarGlobal 3D</h2>
			<p class="lead">Danh mục dự án đầy đủ và giải pháp theo từng ngành có trên website công ty.</p>
			<p><a class="btn" href={links.company} target="_blank" rel="noopener">Truy cập StarGlobal3D.com</a></p>
		</div>
	</section>
</Site>

<style>
	.list {
		display: grid;
		gap: 3.5rem;
	}
	.item {
		display: grid;
		grid-template-columns: 1.25fr 1fr;
		gap: 2.5rem;
		align-items: center;
		color: inherit;
		text-decoration: none;
	}
	.item:nth-child(even) .shot {
		order: 2;
	}
	.shot {
		position: relative;
		overflow: hidden;
		border-radius: 18px;
		box-shadow: 0 20px 50px rgba(15, 23, 42, 0.2);
	}
	.shot :global(img) {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border-radius: 0;
		transition: transform 0.9s ease;
	}
	.item:hover .shot :global(img) {
		transform: scale(1.06);
	}
	.scanline {
		position: absolute;
		top: 0;
		bottom: 0;
		left: -30%;
		width: 30%;
		background: linear-gradient(90deg, transparent, rgba(34, 211, 238, 0.35), transparent);
		opacity: 0;
	}
	.item:hover .scanline {
		opacity: 1;
		animation: sweep 1.3s ease-in-out;
	}
	@keyframes sweep {
		to {
			left: 110%;
		}
	}
	.idx {
		display: block;
		font-size: 3.2rem;
		font-weight: 800;
		line-height: 1;
		color: rgba(8, 145, 178, 0.18);
	}
	.info h2 {
		margin: 0.7rem 0 0.5rem;
		font-size: 1.6rem;
	}
	.info p {
		color: rgb(var(--gray));
	}
	.go {
		font-weight: 700;
		color: var(--accent);
	}
	.go::after {
		content: ' →';
		display: inline-block;
		transition: transform 0.25s ease;
	}
	.item:hover .go::after {
		transform: translateX(6px);
	}
	@media (max-width: 860px) {
		.list {
			gap: 2.5rem;
		}
		.item {
			grid-template-columns: 1fr;
			gap: 1rem;
		}
		.item:nth-child(even) .shot {
			order: 0;
		}
		.idx {
			font-size: 2.2rem;
		}
		.info h2 {
			font-size: 1.3rem;
		}
	}
</style>
