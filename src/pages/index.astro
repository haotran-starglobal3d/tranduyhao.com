---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { COMPANY_URL, SITE_DESCRIPTION, SITE_TAGLINE, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="vi">
	<head>
		<BaseHead title={`${SITE_TITLE} - ${SITE_TAGLINE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>{SITE_TITLE}</h1>
			<p class="tagline">{SITE_TAGLINE}</p>
			<p>
				Xin chào, tôi là Trần Duy Hào, nhà sáng chế, nhà sáng lập và CEO của{' '}
				<a href={COMPANY_URL} target="_blank" rel="noopener">StarGlobal3D.com</a>. Đây là nơi tôi
				chia sẻ góc nhìn, kinh nghiệm và những câu chuyện trên hành trình làm công nghệ.
			</p>
			<p>
				<a href="/about">Giới thiệu thêm về tôi</a> hoặc đọc <a href="/blog">các bài viết</a>.
			</p>

			{
				posts.length > 0 && (
					<section>
						<h2>Bài viết mới</h2>
						<ul class="posts">
							{posts.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`}>{post.data.title}</a>
									<span class="date">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</li>
							))}
						</ul>
					</section>
				)
			}
		</main>
		<Footer />
	</body>
</html>
<style>
	.tagline {
		font-size: 1.2em;
		color: rgb(var(--gray));
		margin-top: -0.5em;
	}
	.posts {
		list-style: none;
		padding: 0;
	}
	.posts li {
		display: flex;
		justify-content: space-between;
		gap: 1em;
		padding: 0.5em 0;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.date {
		color: rgb(var(--gray));
		white-space: nowrap;
	}
</style>
