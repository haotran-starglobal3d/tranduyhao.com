---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import HeroCloud from '../components/HeroCloud.astro';
import { SITE_DESCRIPTION, SITE_TAGLINE, SITE_TITLE } from '../consts';
import { img } from '../data/images';
import { lifeImg, lifeTeaser } from '../data/life';
import {
	career,
	headline,
	honors,
	industries,
	links,
	outlets,
	patents,
	personalStats,
	pillars,
	press,
	showcase,
	stats,
	tv,
} from '../data/profile';
import Site from '../layouts/Site.astro';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

// Tách "350+" thành số 350 và hậu tố "+", để chạy hiệu ứng đếm.
const split = (v: string) => {
	const m = v.match(/^(\d+)(.*)$/);
	return m ? { n: m[1], suffix: m[2] } : { n: '', suffix: v };
};
const featured = showcase.slice(0, 6);
const patentImages = ['patent-us-cover.jpg', 'patent-vn.jpg'];
const journey = [...career].reverse();
---

<Site title={`${SITE_TITLE} - ${SITE_TAGLINE}`} description={SITE_DESCRIPTION} image={img('og.jpg')}>
	<section class="hero">
		<HeroCloud />
		<div class="container hero-inner">
			<div class="hero-text">
				<span class="eyebrow" data-reveal>Nhà sáng chế - Chuyên gia công nghệ số hóa 3D</span>
				<h1 data-reveal style="--d:80ms"><span class="gradient-text">{headline.name}</span></h1>
				<p class="roles" data-reveal style="--d:160ms">
					{headline.roles.map((r) => <span>{r}</span>)}
				</p>
				<p class="intro" data-reveal style="--d:240ms">
					Tác giả nền tảng <strong>Smart Digital Twin 3D/360</strong> được cấp bằng sáng chế độc
					quyền tại Hoa Kỳ và Việt Nam. Hơn 22 năm làm việc quốc tế qua ba lĩnh vực: hàng không,
					dầu khí ngoài khơi và chuyển đổi số.
				</p>
				<p class="cta" data-reveal style="--d:320ms">
					<a class="btn" href="/du-an/">Xem dự án tiêu biểu</a>
					<a class="btn ghost" href="/about/">Hành trình của tôi</a>
				</p>
				<dl class="mini" data-reveal style="--d:400ms">
					{personalStats.map((s) => {
						const p = split(s.value);
						return (
							<div>
								<dt><span data-count={p.n} data-suffix={p.suffix}>{s.value}</span></dt>
								<dd>{s.label}</dd>
							</div>
						);
					})}
				</dl>
			</div>
			<div class="hero-art" data-reveal="zoom" style="--d:200ms">
				<div class="halo" aria-hidden="true"></div>
				<svg class="orbits" viewBox="0 0 400 400" aria-hidden="true">
					<g class="o1"><ellipse cx="200" cy="200" rx="190" ry="70" /><circle cx="390" cy="200" r="5" /></g>
					<g class="o2"><ellipse cx="200" cy="200" rx="190" ry="70" /><circle cx="10" cy="200" r="4" /></g>
					<g class="o3"><circle cx="200" cy="200" r="150" /><circle cx="200" cy="50" r="4" /></g>
				</svg>
				<Image
					class="portrait"
					src={img('portrait.png')}
					alt="Dr. Trần Duy Hào cùng bằng sáng chế Hoa Kỳ và bằng độc quyền sáng chế Việt Nam"
					widths={[420, 640, 900]}
					sizes="(max-width: 860px) 70vw, 420px"
					loading="eager"
					fetchpriority="high"
				/>
				<div class="badge b1"><small>USPTO - Hoa Kỳ</small>US 10,922,881 B2</div>
				<div class="badge b2"><small>NOIP - Việt Nam</small>Sáng chế số 41304</div>
				<div class="badge b3"><small>IAU - Hoa Kỳ</small>PhD (Hon.) 2024</div>
			</div>
		</div>
		<a class="scroll-hint" href="#so-lieu" aria-label="Cuộn xuống"><span></span></a>
	</section>

	<section class="stats" id="so-lieu">
		<div class="container stats-grid" data-stagger="70">
			{stats.map((s) => {
				const p = split(s.value);
				return (
					<div>
						<strong><span data-count={p.n} data-suffix={p.suffix}>{s.value}</span></strong>
						<span>{s.label}</span>
					</div>
				);
			})}
		</div>
		<p class="container stats-note">Số liệu do StarGlobal 3D công bố, tính đến năm 2026.</p>
	</section>

	<section class="outlets" aria-label="Các kênh truyền thông đã đưa tin">
		<div class="container">
			<p class="outlets-label">Đã xuất hiện trên</p>
		</div>
		<div class="marquee">
			<div class="marquee-track">
				{[...outlets, ...outlets].map((o, i) => <span aria-hidden={i >= outlets.length}>{o}</span>)}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<span class="eyebrow" data-reveal>Sở hữu trí tuệ</span>
			<h2 data-reveal>Hai bằng sáng chế độc quyền</h2>
			<p class="lead" data-reveal>
				Giải pháp bản đồ số hóa 3D/360 tích hợp thông tin thời gian thực được bảo hộ tại Hoa Kỳ và
				Việt Nam, với vai trò tác giả sáng chế chính.
			</p>
			<div class="patents">
				{patents.map((p, i) => (
					<article class="patent lift" data-reveal={i === 0 ? 'left' : 'right'} data-tilt>
						<Image src={img(patentImages[i])} alt={`Bằng sáng chế ${p.office}`} width={220} />
						<div>
							<span class="chip">{p.office} - {p.country}</span>
							<h3>{p.number}</h3>
							<p class="pdate">Cấp ngày {p.date} - {p.officeFull}</p>
							<p>{p.titleVi}</p>
							{i === 0 && <a href={p.url} target="_blank" rel="noopener">Xem trên Google Patents</a>}
						</div>
					</article>
				))}
			</div>
			<p class="more" data-reveal><a href="/thanh-tuu/">Xem toàn bộ sáng chế, bản quyền và giải thưởng</a></p>
		</div>
	</section>

	<section class="section dark tech">
		<div class="container">
			<span class="eyebrow" data-reveal>Công nghệ</span>
			<h2 data-reveal>Smart Digital Twin 3D/360</h2>
			<p class="lead" data-reveal>
				Bản sao số tương tác thông minh: không gian thật được đưa lên môi trường số với kích thước
				chính xác, đầy đủ thông tin và dữ liệu thời gian thực.
			</p>
			<div class="grid cols-3" data-stagger="80">
				{pillars.map((p, i) => (
					<div class="card lift">
						<span class="num">{String(i + 1).padStart(2, '0')}</span>
						<h3>{p.title}</h3>
						<p>{p.text}</p>
					</div>
				))}
			</div>
			<p class="more" data-reveal><a href="/cong-nghe/">Tìm hiểu cách công nghệ vận hành</a></p>
		</div>
	</section>

	<section class="section alt">
		<div class="container">
			<span class="eyebrow" data-reveal>Dự án tiêu biểu</span>
			<h2 data-reveal>Những không gian đã được số hóa</h2>
			<p class="lead" data-reveal>
				Từ bản đồ du lịch của cả một thành phố đến di tích quốc gia, nhà máy, trường đại học. Bấm
				vào từng dự án để trải nghiệm trực tiếp.
			</p>
			<div class="projects" data-stagger="80">
				{featured.map((p) => (
					<a class="project" href={p.url} target="_blank" rel="noopener">
						<Image src={img(p.image)} alt={p.title} widths={[480, 800]} sizes="(max-width: 860px) 100vw, 360px" />
						<div class="pbody">
							<span class="chip">{p.tag}</span>
							<h3>{p.title}</h3>
							<p>{p.text}</p>
						</div>
					</a>
				))}
			</div>
			<p class="more" data-reveal><a href="/du-an/">Xem đủ 12 dự án tiêu biểu</a></p>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<span class="eyebrow" data-reveal>Hành trình</span>
			<h2 data-reveal>Từ bầu trời, biển khơi đến không gian số</h2>
			<p class="lead" data-reveal>
				Ba lĩnh vực kỹ thuật, hơn 20 quốc gia, một mạch xuyên suốt: đưa những hệ thống phức tạp về
				dạng con người có thể nhìn thấy, đo đạc và quản lý.
			</p>
			<ol class="journey" data-stagger="110">
				{journey.map((c) => (
					<li>
						<span class="dot" aria-hidden="true"></span>
						<span class="period">{c.period}</span>
						<span class="chip">{c.field}</span>
						<h3>{c.role}</h3>
						<p>{c.company}</p>
					</li>
				))}
			</ol>
			<p class="more" data-reveal><a href="/about/">Đọc tiểu sử, học vấn và kinh nghiệm chi tiết</a></p>
		</div>
	</section>

	<section class="section dark awards-band">
		<div class="container">
			<span class="eyebrow" data-reveal>Ghi nhận</span>
			<h2 data-reveal>{honors.length} giải thưởng từ 2018 đến 2025</h2>
			<p class="lead" data-reveal>
				Sao Khuê, Top Industrie 4.0, Chuyển đổi số Việt Nam, Giải thưởng Sáng tạo TP.HCM và nhiều
				ghi nhận khác cho nền tảng bản đồ số hóa tương tác thông minh 3D/360.
			</p>
		</div>
		<div class="marquee" style="--speed:60s">
			<div class="marquee-track awards-track">
				{[...honors, ...honors].map((h, i) => (
					<figure aria-hidden={i >= honors.length}>
						<Image src={img(h.image)} alt={h.name} height={220} />
						<figcaption><b>{h.year}</b> {h.name}</figcaption>
					</figure>
				))}
			</div>
		</div>
		<div class="container">
			<p class="more" data-reveal><a href="/thanh-tuu/">Xem chi tiết từng giải thưởng</a></p>
		</div>
	</section>

	<section class="section alt">
		<div class="container">
			<span class="eyebrow" data-reveal>Lĩnh vực ứng dụng</span>
			<h2 data-reveal>Một nền tảng, nhiều ngành</h2>
			<div class="grid cols-3" data-stagger="70">
				{industries.map((i) => (
					<div class="card lift">
						<h3>{i.title}</h3>
						<p>{i.text}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<span class="eyebrow" data-reveal>Báo chí và truyền hình</span>
			<h2 data-reveal>Truyền thông nói gì</h2>
			<div class="grid cols-2" data-stagger="100">
				{press.map((p) => (
					<a class="card quote lift" href={p.url} target="_blank" rel="noopener">
						<blockquote>"{p.quote}"</blockquote>
						<p class="by"><b>{p.outlet}</b>, {p.date} - {p.title}</p>
					</a>
				))}
			</div>
			<div class="tv" data-stagger="90">
				{tv.slice(0, 2).map((t) => (
					<a class="tvcard" href={t.url} target="_blank" rel="noopener">
						<img src={`https://i.ytimg.com/vi/${t.yt}/hqdefault.jpg`} alt={t.show} loading="lazy" width="480" height="360" />
						<span class="play" aria-hidden="true"></span>
						<span class="tvtext"><b>{t.show}</b>{t.detail}</span>
					</a>
				))}
			</div>
			<p class="more" data-reveal><a href="/bao-chi/">Xem toàn bộ bài báo và phóng sự truyền hình</a></p>
		</div>
	</section>

	{
		posts.length > 0 && (
			<section class="section alt">
				<div class="container">
					<span class="eyebrow">Bài viết</span>
					<h2>Bài viết mới</h2>
					<ul class="posts">
						{posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>{post.data.title}</a>
								<span class="date"><FormattedDate date={post.data.pubDate} /></span>
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}

	<section class="section life">
		<div class="container">
			<span class="eyebrow" data-reveal>Đời sống</span>
			<h2 data-reveal>Ngoài công việc</h2>
			<p class="lead" data-reveal>
				Những chuyến đi dọc đất nước, ngày hội cổ vũ, vườn rau và giàn lan: một góc đời thường bên
				cạnh công nghệ.
			</p>
			<div class="life-row" data-stagger="80">
				{lifeTeaser.map((n) => (
					<a class="life-pic" href="/doi-song/">
						<Image src={lifeImg(n)} alt="Khoảnh khắc đời thường của Trần Duy Hào" widths={[360, 640]} sizes="(max-width: 860px) 50vw, 270px" />
					</a>
				))}
			</div>
			<p class="more" data-reveal><a href="/doi-song/">Xem góc đời sống</a></p>
		</div>
	</section>

	<section class="section dark closing">
		<div class="container" data-reveal="zoom">
			<h2>Mỗi không gian được số hóa là một <span class="gradient-text">di sản số</span></h2>
			<p class="lead">Kết nối để trao đổi về số hóa 3D, bản sao số và chuyển đổi số.</p>
			<p class="cta">
				<a class="btn" href={links.company} target="_blank" rel="noopener">Truy cập StarGlobal3D.com</a>
				<a class="btn ghost" href={links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
				<a class="btn ghost" href={links.facebook} target="_blank" rel="noopener">Facebook</a>
			</p>
		</div>
	</section>
</Site>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		background:
			radial-gradient(900px 500px at 78% 30%, rgba(34, 211, 238, 0.16), transparent 70%),
			linear-gradient(160deg, var(--navy) 0%, var(--navy-2) 100%);
		color: #c9d6ea;
	}
	.hero-inner {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: 1.15fr 0.85fr;
		gap: 2rem;
		align-items: end;
		min-height: min(86vh, 780px);
		padding-top: 4rem;
	}
	.hero-text {
		align-self: center;
		padding-bottom: 4rem;
	}
	.hero .eyebrow {
		color: var(--cyan);
	}
	.hero h1 {
		font-size: clamp(2.4rem, 5.2vw, 4.2rem);
		line-height: 1.05;
		margin-bottom: 1rem;
	}
	.roles {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1.25rem;
	}
	.roles span {
		padding: 0.3rem 0.85rem;
		border: 1px solid rgba(34, 211, 238, 0.4);
		border-radius: 999px;
		font-size: 0.9rem;
		font-weight: 700;
		color: #a5f3fc;
		background: rgba(34, 211, 238, 0.08);
	}
	.intro {
		max-width: 560px;
		font-size: 1.12rem;
	}
	.intro strong {
		color: #fff;
	}
	.cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 1.75rem 0 0;
	}
	.mini {
		display: grid;
		grid-template-columns: repeat(4, auto);
		justify-content: start;
		gap: 2rem;
		margin: 2.5rem 0 0;
		padding-top: 1.5rem;
		border-top: 1px solid rgba(255, 255, 255, 0.12);
	}
	.mini dt {
		font-size: 2rem;
		font-weight: 800;
		line-height: 1.1;
		color: var(--gold);
		font-variant-numeric: tabular-nums;
	}
	.mini dd {
		margin: 0.2rem 0 0;
		font-size: 0.85rem;
		color: #a9bbd6;
	}
	.hero-art {
		position: relative;
		display: flex;
		justify-content: center;
		align-self: end;
	}
	.hero-art :global(.portrait) {
		position: relative;
		z-index: 2;
		display: block;
		width: min(100%, 420px);
		height: auto;
		border-radius: 0;
		filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.5));
		mask-image: linear-gradient(180deg, #000 82%, transparent 100%);
		-webkit-mask-image: linear-gradient(180deg, #000 82%, transparent 100%);
	}
	.halo {
		position: absolute;
		left: 50%;
		top: 30%;
		width: 420px;
		height: 420px;
		transform: translate(-50%, -50%);
		border-radius: 50%;
		background: radial-gradient(circle, rgba(34, 211, 238, 0.4), rgba(34, 211, 238, 0.05) 55%, transparent 70%);
		animation: breathe 6s ease-in-out infinite;
	}
	.orbits {
		position: absolute;
		left: 50%;
		top: 30%;
		z-index: 1;
		width: 520px;
		max-width: 125%;
		transform: translate(-50%, -50%);
		overflow: visible;
	}
	.orbits ellipse,
	.orbits g > circle:first-child:not(:last-child) {
		fill: none;
		stroke: rgba(34, 211, 238, 0.35);
		stroke-width: 1;
		stroke-dasharray: 3 7;
	}
	.orbits g > circle:last-child {
		fill: var(--gold);
		filter: drop-shadow(0 0 6px var(--gold));
	}
	.orbits g {
		transform-origin: 200px 200px;
	}
	.o1 {
		animation: spin 26s linear infinite;
	}
	.o2 {
		animation: spin 34s linear infinite reverse;
		rotate: 60deg;
	}
	.o3 {
		animation: spin 48s linear infinite;
	}
	.badge {
		position: absolute;
		z-index: 3;
		padding: 0.55rem 0.9rem;
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-radius: 12px;
		background: rgba(7, 18, 38, 0.72);
		backdrop-filter: blur(8px);
		color: #fff;
		font-size: 0.92rem;
		font-weight: 800;
		line-height: 1.3;
		white-space: nowrap;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
		animation: float 6s ease-in-out infinite;
	}
	.badge small {
		display: block;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--cyan);
	}
	.b1 {
		left: -8%;
		top: 22%;
	}
	.b2 {
		right: -6%;
		top: 44%;
		animation-delay: -2s;
	}
	.b3 {
		left: -2%;
		bottom: 16%;
		animation-delay: -4s;
	}
	.scroll-hint {
		position: absolute;
		left: 50%;
		bottom: 1rem;
		z-index: 3;
		width: 24px;
		height: 38px;
		margin-left: -12px;
		border: 2px solid rgba(255, 255, 255, 0.4);
		border-radius: 14px;
	}
	.scroll-hint span {
		position: absolute;
		left: 50%;
		top: 7px;
		width: 4px;
		height: 8px;
		margin-left: -2px;
		border-radius: 2px;
		background: var(--cyan);
		animation: wheel 1.8s ease-in-out infinite;
	}
	@keyframes spin {
		to {
			transform: rotate(360deg);
		}
	}
	@keyframes float {
		50% {
			transform: translateY(-10px);
		}
	}
	@keyframes breathe {
		50% {
			transform: translate(-50%, -50%) scale(1.08);
			opacity: 0.8;
		}
	}
	@keyframes wheel {
		0% {
			opacity: 0;
			transform: translateY(0);
		}
		40% {
			opacity: 1;
		}
		100% {
			opacity: 0;
			transform: translateY(14px);
		}
	}

	.stats {
		padding: 2.75rem 0 1.5rem;
		background: #050d1c;
		color: #a9bbd6;
	}
	.stats-grid {
		display: grid;
		grid-template-columns: repeat(6, 1fr);
		gap: 1rem;
	}
	.stats-grid strong {
		display: block;
		font-size: 2.1rem;
		line-height: 1.1;
		color: #fff;
		font-variant-numeric: tabular-nums;
	}
	.stats-grid div > span {
		font-size: 0.86rem;
	}
	.stats-note {
		margin-top: 1.25rem;
		font-size: 0.8rem;
		color: #6f84a8;
	}
